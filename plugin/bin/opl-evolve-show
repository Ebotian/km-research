#!/usr/bin/env python3
"""opl-evolve-show —— 看程序库。薄壳：逻辑在 lib/opl_evolve.py。

用法：
    opl-evolve-show --lab DIR [--id N | --best METRIC] [--limit N] [--json]

`stdout` 只出 JSON（与其他命令的流约定一致）；人看的摘要走 `stderr`。

退出码：
    0  有结果
    2  参数错或实验目录不存在
    5  EMPTY：库是空的，或指定的 id 不在库里
"""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

from opl_common import PASS, USAGE, EMPTY, c  # noqa: E402
from opl_evolve import (EvolveError, ProgramLibrary, lab_paths,  # noqa: E402
                        load_problem, parse_where)

def summary_keys(lab: str) -> tuple[str, ...]:
    """摘要打哪几个字段，**从实验定义读**，不硬编码。

    原先这里写死 `("sorts", "comparators", "zero_one_inputs_checked")`——那等于把
    「所有实验都是排序网络」钉进了展示层：换成 `feasible`/`loss` 的问题，摘要一律
    显示「无指标」，而库里其实有数。定义读不到时退回「读到什么打什么」。
    """
    try:
        problem = load_problem(lab_paths(lab)["problem"])
    except EvolveError:
        return ()
    keys = [problem.feasible_field]
    if problem.objective_field:
        keys.append(problem.objective_field)
    keys += [k for k in problem.required if k not in keys]
    return tuple(keys)


def brief(rec: dict, keys: tuple[str, ...] = ()) -> str:
    m = rec.get("metrics") or {}
    use = keys or tuple(sorted(m))
    bits = " ".join(f"{k}={m[k]}" for k in use if k in m) or "无指标"
    return (f"id={rec['id']:<4} 第{rec['generation']}代  {bits}  "
            f"op={rec.get('operation') or '-'}  {rec['code_hash'][:12]}…")


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--lab", required=True)
    ap.add_argument("--id", type=int, default=None)
    ap.add_argument("--best", default=None, help="按某个 metrics 字段取最好的一条")
    ap.add_argument("--where", action="append", default=None, metavar="KEY=VALUE",
                    help="只在此条件成立的行里取最好（可重复）。"
                         "**不加它是危险的**：数字最小不等于最好——"
                         "实测会选中一条不可行的候选（本仓库夹具是排序网络，"
                         "那条是 4 比较器但不排序的网络）")
    # 方向默认**跟随实验定义**：定义说最大化就最大化。原先这个开关 `default=True`
    # 且没有反向选项，于是「最大化」的定义下永远选反（实测：score=0 与 9，选中 0）。
    ap.add_argument("--minimize", dest="minimize", action="store_true", default=None,
                    help="强制按最小化（默认跟随实验定义的 objective.minimize）")
    ap.add_argument("--maximize", dest="minimize", action="store_false",
                    help="强制按最大化")
    ap.add_argument("--limit", type=int, default=None)
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    p = lab_paths(args.lab)
    if not os.path.isfile(p["db"]):
        c(f"实验目录不存在：{p['db']}（先跑 opl-evolve-init）")
        return USAGE

    keys = summary_keys(args.lab)
    with ProgramLibrary(p["db"]) as lib:
        if args.id is not None:
            rec = lib.get(args.id)
            if rec is None:
                c(f"库里没有 id={args.id}")
                return EMPTY
            # 身份与运行分列：同一个 id 可能跑过很多次（补测、换预算、换评估器），
            # 每次都留在运行史里，并把「哪次跑的、什么条件」一起给出来
            rec["evaluations"] = lib.evaluations(args.id)
            print(json.dumps(rec, ensure_ascii=False, indent=2, sort_keys=True))
            c(brief(rec, keys))
            for e in rec["evaluations"]:
                c(f"  运行 #{e['id']}  {e['kind']:<22} feasible={e['feasible']}  "
                  f"{e['created_at']}  {e.get('run_dir') or '-'}")
            return PASS
        if args.best:
            try:
                where = parse_where(args.where)
            except EvolveError as exc:
                c(str(exc))
                return USAGE
            # 方向：显式开关 > 实验定义 > 最小化（定义没写 objective 时）
            try:
                prob = load_problem(lab_paths(args.lab)["problem"])
                defined = prob.objective_minimize
                defined_field = prob.objective_field
            except EvolveError:
                defined, defined_field = True, None
            direction = args.minimize if args.minimize is not None else defined
            if defined_field and args.best != defined_field:
                c(f"注意：实验定义的目标字段是 {defined_field!r}，而你按 {args.best!r} 取最好"
                  f"——这可能是两次不同的比较")
            # 当前实验的指纹：换了定义或评估器之后，旧成绩不可比，必须排除
            from opl_ledger import sha256_file as _sha
            try:
                fp = (_sha(lab_paths(args.lab)["problem"]),
                      _sha(lab_paths(args.lab)["evaluator"]))
            except OSError:
                fp = None
            rec = lib.best(args.best, minimize=direction, where=where, fingerprints=fp)
            if getattr(lib, "skipped_incomparable", 0):
                c(f"注意：跳过了 {lib.skipped_incomparable} 条**不同实验定义/评估器**的成绩"
                  f"——同名指标不代表可直接比较")
            if rec is None:
                c(f"没有任何程序带指标 {args.best!r}"
                  + (f" 且满足 {where}" if where else "")
                  + ("；注意不加 --where 时不可行的程序也会参与比较" if not where else ""))
                return EMPTY
            print(json.dumps(rec, ensure_ascii=False, indent=2, sort_keys=True))
            c(f"best({args.best}, {'最小' if direction else '最大'}) → " + brief(rec, keys))
            if not where:
                c("提示：未加 --where，选出的可能是不可行的程序（数字最小不等于最好）")
            return PASS
        rows = lib.all_programs(limit=args.limit)
        if not rows:
            c("库是空的")
            return EMPTY
        out = {"schema": "opl.evolve.show/1", "count": len(rows),
               "programs": [{k: r[k] for k in ("id", "parent_id", "generation",
                                               "island", "cell_key", "code_hash",
                                               "hash_mode", "operation", "created_at")}
                            | {"metrics": r.get("metrics")} for r in rows]}
        print(json.dumps(out, ensure_ascii=False, indent=2, sort_keys=True))
        for r in rows:
            c(brief(r, keys))
        return PASS


if __name__ == "__main__":
    sys.exit(main())
