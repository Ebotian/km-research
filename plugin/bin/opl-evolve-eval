#!/usr/bin/env python3
"""opl-evolve-eval —— 在沙箱里评估一份候选并入库。薄壳：逻辑在 lib/opl_evolve.py。

用法：
    opl-evolve-eval --lab DIR --candidate PATH [--generation N] [--parent ID]
                    [--operation S] [--timeout S] [--mem-mb N] [--json]

检查顺序是刻意的：**先做便宜且确定的，再花沙箱的钱**。
区外改动是「候选不合格」（去修候选）；重复是「已经知道」（换个变异）；
沙箱没给出判决是「还不知道」。三种结局的退出码各不相同。

退出码：
    0  PASS     候选入库，且**按冻结的实验定义**判定为可行
    1  REJECT   候选入库，但判定为不可行 —— 「这份候选可用」被推翻
    2  USAGE    候选不合格（缺标记 / 区外被改），或评估器产出的指标不符合实验定义
    3  UNKNOWN  沙箱**没有给出判决**（超时 / 被 OOM 杀 / 被杀 / 没写出产物）。
                这不是「候选不行」——别读错
    4  MISSING  找不到 bwrap。不降级到裸跑
    5  EMPTY    重复：`code_hash` 命中，没有新增任何东西
"""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

from opl_common import PASS, REJECT, UNKNOWN, MISSING, USAGE, EMPTY, c, s  # noqa: E402
from opl_evolve import EvolveError, eval_candidate  # noqa: E402

VERDICT_LINE = {
    PASS: "FEASIBLE",
    REJECT: "INFEASIBLE",
    USAGE: "INVALID",
    UNKNOWN: "NO_VERDICT",
    MISSING: "SANDBOX_MISSING",
    EMPTY: "DUPLICATE",
}


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--lab", required=True)
    ap.add_argument("--candidate", required=True)
    ap.add_argument("--generation", type=int, default=1)
    ap.add_argument("--parent", type=int, default=None)
    ap.add_argument("--operation", default=None)
    ap.add_argument("--timeout", type=float, default=60.0)
    ap.add_argument("--mem-mb", type=int, default=None)
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    try:
        out = eval_candidate(args.lab, args.candidate, generation=args.generation,
                             parent_id=args.parent, operation=args.operation,
                             timeout=args.timeout, mem_max_mb=args.mem_mb)
    except EvolveError as exc:
        c(str(exc))
        return USAGE

    rc = out.exit_code
    if out.reason:
        c(f"注意：{out.reason}")
    if out.program_id is not None:
        c(f"程序 id={out.program_id}  code_hash={out.code_hash[:16]}…")
    if out.run_dir:
        c(f"运行目录 {out.run_dir}")
    if args.json:
        print(json.dumps({
            "schema": "opl.evolve.eval/1",
            "kind": out.kind, "exit": rc, "program_id": out.program_id,
            "code_hash": out.code_hash, "duplicate": out.duplicate,
            "reason": out.reason, "metrics": out.metrics, "run_dir": out.run_dir,
        }, ensure_ascii=False, indent=2, sort_keys=True))
    # 摘要只打**实验定义要求的那几个字段**，不硬编码具体指标名：插件不认识
    # `sorts` 或 `comparators`，可行性由定义给出（判据 F4）。
    detail = ""
    if out.metrics:
        want = out.summary_fields or sorted(out.metrics)
        bits = [f"{k}={out.metrics[k]}" for k in want if k in out.metrics]
        detail = "  " + " ".join(bits[:4])
    s(VERDICT_LINE.get(rc, "UNKNOWN"), detail.strip())
    return rc


if __name__ == "__main__":
    sys.exit(main())
