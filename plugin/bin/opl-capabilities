#!/usr/bin/env python3
"""opl-capabilities —— 探测后端能力，产出机器可读的能力快照。
薄壳：探测逻辑在 lib/opl_probe.py。

一个职责：把「本机现在有什么」变成可查询的事实，而不是假设。
不安装任何东西，不修改系统，只做只读探测。

用法：
    opl-capabilities [--out PATH] [--json] [--layer NAME] [--python PATH]
                     [--no-python] [--python-timeout S] [--quiet]

退出码：0 = 必需层齐全；4 = 必需层有缺失；2 = 参数错误。其余见 opl_common。
stdout：JSON 对象（默认）或单行 `s ...`（--quiet）。

探测为何要带硬超时、为何要区分「存在」与「可用」、为何要按解释器分别探 Python
模块——三条理由都写在 lib/opl_probe.py 的 docstring 里，改动前请先读它。
"""

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

from opl_common import PASS, MISSING, USAGE, c, out_json, s  # noqa: E402
from opl_probe import LAYERS, ProbeError, build_snapshot  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--out", help="把 JSON 写入该路径（默认写 stdout）")
    ap.add_argument("--json", action="store_true", help="总是输出 JSON 到 stdout")
    ap.add_argument("--layer", action="append", help="只探测指定层，可重复")
    ap.add_argument("--python", action="append", dest="pythons",
                    help="要探测的解释器路径，可重复；默认探 $OPL_PYTHON、插件 venv、系统 python3")
    ap.add_argument("--no-python", action="store_true", help="跳过 Python 模块探测")
    ap.add_argument("--timeout", type=float, default=5.0, help="单次可执行文件探测超时秒数")
    ap.add_argument("--python-timeout", type=float, default=30.0, help="单次解释器探测超时秒数")
    ap.add_argument("--quiet", action="store_true", help="stdout 只输出一行判决")
    args = ap.parse_args()

    try:
        snapshot, log = build_snapshot(
            layers=args.layer, pythons=args.pythons, timeout=args.timeout,
            python_timeout=args.python_timeout, do_python=not args.no_python)
    except ProbeError as exc:
        c(str(exc))
        return USAGE

    for line in log:
        c(line)

    required_missing = snapshot["required_missing"]
    if args.out:
        out_json(snapshot, args.out)
    if args.quiet:
        if required_missing:
            s("MISSING", ",".join(required_missing))
            return MISSING
        s("PASS")
        return PASS
    if args.out and not args.json:
        c("提示：用 --json 可同时把快照打到 stdout")
    else:
        out_json(snapshot)

    if required_missing:
        c(f"必需层缺失：{', '.join(required_missing)}")
        return MISSING
    broken = snapshot["broken"]
    if broken:
        c(f"存在但功能异常：{', '.join(broken)}")
    split = snapshot["split_brain"]
    if split:
        c(f"Python 依赖分裂（没有任何单一解释器同时满足）：{', '.join(split)}")
        for layer in split:
            for path, missing in snapshot["py_layers"][layer]["missing_by_interpreter"].items():
                c(f"  {path} 缺 {', '.join(missing)}")
    return PASS


if __name__ == "__main__":
    sys.exit(main())
