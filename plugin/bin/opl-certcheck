#!/usr/bin/env python3
"""opl-certcheck —— 用独立校验器复核一份证书。

一个职责：把「求解器说 UNSAT」变成「第三方可以在不信任求解器的前提下复核」。
自己不判断数学，只调度校验器并把结果翻译成退出码。

用法：
    opl-certcheck --formula F.cnf --cert P.drat [--format auto|drat|lrat|clrat]
                  [--timeout S] [--json] [--evidence-out PATH] [--verbose]

退出码：
    0 PASS     校验器报告 VERIFIED
    1 REJECT   校验器报告 NOT VERIFIED，且证据表明证书被完整解析
    3 UNKNOWN  无法判定：格式未识别 / 解析不完整 / 超时 / 解压器坏了
    4 MISSING  所需校验器不存在
    2 USAGE    参数错误

本工具最不能犯的错，是把「我读不懂这份证书」报成「这份证书是错的」——那是伪证。
因此每条路径都必须自己回答「证书被完整读入了吗」，答不上来就走 UNKNOWN：

  drat 路径  校验器自报 `read N bytes from proof file`，与证书实际字节数比对。
  lrat 路径  校验器自报 `Last line checked = N`；N=0 说明一行证明都没读进去。
  clrat 路径 上游 decompress 在 read_lit 里有一句遗留 printf，会把原始字节混入
             stdout，输出不是合法 LRAT。解压后先验语法，不合法就 UNKNOWN。
"""

from __future__ import annotations

import argparse
import bz2
import hashlib
import os
import re
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from opl_common import (PASS, REJECT, UNKNOWN, MISSING, c, find_tool, out_json, run, s)  # noqa: E402

# 校验器的判决行：drat-trim 写 `s X`，lrat-check 写 `c X`。
VERDICT_RE = re.compile(r"^(?:[cs] )?(VERIFIED|NOT VERIFIED)\s*$", re.M)
READ_BYTES_RE = re.compile(r"read (\d+) bytes from proof file")
LAST_LINE_RE = re.compile(r"Last line checked = (\d+)")
# 合法 LRAT 行：`<id> d <ids>* 0` 或 `<id> <lits>* 0 <hints>* 0`
LRAT_LINE = re.compile(r"^\d+ (?:d(?: -?\d+)* 0|(?:-?\d+\s+)*0\s+(?:-?\d+\s+)*0)$")


def sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def normalise(text: str) -> str:
    """把行尾统一成 `\\n`。

    drat-trim 用 `\\r` 覆盖进度行，于是原始字节里出现「行首 `\\r`」。锚定到 `^`
    的判决行正则会因此失配——注意用文本模式读文件测不出这个问题，因为 Python
    的通用换行会替你翻译 `\\r`，而 `bytes.decode()` 不会。
    """
    return text.replace("\r\n", "\n").replace("\r", "\n")


def check(exe: str, argv: list[str], timeout: float) -> tuple[int | None, str, int]:
    """执行校验器，返回 (退出码, 合并输出, 毫秒)。退出码 None 表示超时。"""
    t0 = time.monotonic()
    rc, out, err = run([exe, *argv], timeout=timeout)
    merged = normalise((out or b"").decode("utf-8", "replace"))
    etext = normalise((err or b"").decode("utf-8", "replace"))
    if etext.strip():
        merged += "\n" + etext
    return rc, merged.strip(), int((time.monotonic() - t0) * 1000)


def load_cert(path: str, workdir: str) -> tuple[str, str | None]:
    with open(path, "rb") as fh:
        if fh.read(3) != b"BZh":
            return path, None
    dst = os.path.join(workdir, "cert.unpacked")
    with bz2.open(path, "rb") as src, open(dst, "wb") as out:
        while chunk := src.read(1 << 20):
            out.write(chunk)
    return dst, f"解压 {path} -> {dst}"


def sniff(path: str) -> tuple[str, str]:
    """返回 (格式, 依据)。"""
    with open(path, "rb") as fh:
        head = fh.read(1 << 16)
    if not head:
        return "unknown", "空文件"
    if any(b > 126 or b < 9 for b in head[:4096]):
        return "drat", "前 4 KiB 含非可打印字节（二进制证明）"
    try:
        text = head.decode("utf-8")
    except UnicodeDecodeError:
        return "drat", "非 UTF-8（二进制证明）"
    data = [ln.strip() for ln in text.splitlines()
            if ln.strip() and not ln.lstrip().startswith(("c", "p"))]
    if not data:
        return "unknown", "无可判读的证明行"
    # LRAT 的添加行有两个 0（文字终结符 + 提示终结符），DRAT 只有一个。
    # 注意不能只看第一行：LRAT 常见的首行是 `<id> d 0`，会被误判成 DRAT。
    for ln in data:
        if LRAT_LINE.match(ln):
            return "lrat", f"存在符合 LRAT 语法的行（如 {ln[:44]!r}）"
    return "drat", f"无 LRAT 语法行（首行 {data[0][:44]!r}）"


def malformed_lrat(text: str) -> list[str]:
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    return [ln for ln in lines if not LRAT_LINE.match(ln)]


def last_line_checked(log: str) -> int | None:
    m = LAST_LINE_RE.search(log)
    return int(m.group(1)) if m else None


def checker_messages(log: str, max_lines: int = 20, max_chars: int = 2000) -> list[str] | None:
    """摘录检查器的诊断行，供证据记录留证。

    只取 `c ` / `s ` 开头的行——那是 SAT 竞赛系的约定，drat-trim、lrat-check、
    cake_lpr 都遵守。截断到固定行数与字符数，避免把整份日志塞进记录。
    拒绝情形尤其需要它：「哪一行、什么原因」是事后审计唯一能回答
    「为什么这份证书不算」的东西，而各检查器的措辞并不统一。
    """
    picked: list[str] = []
    total = 0
    for line in log.splitlines():
        line = line.strip()
        if not (line.startswith("c ") or line.startswith("s ")):
            continue
        picked.append(line)
        total += len(line)
        if len(picked) >= max_lines or total >= max_chars:
            break
    return picked or None


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("formula_pos", nargs="?")
    ap.add_argument("cert_pos", nargs="?")
    ap.add_argument("--formula")
    ap.add_argument("--cert")
    ap.add_argument("--format", default="auto",
                    choices=["auto", "drat", "lrat", "clrat", "lpr", "alethe"])
    ap.add_argument("--timeout", type=float, default=3600.0)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--evidence-out")
    ap.add_argument("--verbose", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    formula = args.formula or args.formula_pos
    cert = args.cert or args.cert_pos
    if not formula or not cert:
        c("需要 --formula 与 --cert")
        return 2
    for p in (formula, cert):
        if not os.path.isfile(p):
            c(f"文件不存在：{p}")
            return 2

    workdir = tempfile.mkdtemp(prefix="opl-certcheck.")
    unpacked, note = load_cert(cert, workdir)
    if note:
        c(note)

    fmt, why = args.format, "由 --format 指定"
    if fmt == "auto":
        # 先看扩展名：`.lpr` 与 LRAT 行语法相同，Alethe 是 Lisp 括号式，两者
        # sniff 都分辨不出来，而它们该走各自的检查器。
        if cert.endswith(".lpr"):
            fmt, why = "lpr", "扩展名为 .lpr"
        elif cert.endswith((".alethe", ".alethe.txt")):
            fmt, why = "alethe", "扩展名为 .alethe"
        else:
            fmt, why = sniff(unpacked)
    if fmt == "unknown":
        return die_unknown(f"无法识别证书格式：{why}", args)
    c(f"格式判定：{fmt}（{why}）")

    started = time.monotonic()
    backend, log = "", ""
    parsed_ok: bool | None = None
    extra: dict = {}

    if fmt == "drat":
        exe = find_tool("drat-trim")
        if exe is None:
            return die_missing("drat-trim", args)
        backend = "drat-trim"
        rc, log, _ = check(exe, [formula, unpacked, "-t", str(int(args.timeout))], args.timeout)
        if rc is None:
            return die_unknown("drat-trim 超时", args, backend, extra)
        cert_bytes = os.path.getsize(unpacked)
        m = READ_BYTES_RE.search(log)
        parsed = int(m.group(1)) if m else None
        parsed_ok = (parsed == cert_bytes) if parsed is not None else None
        extra |= {"parsed_bytes": parsed, "certificate_bytes": cert_bytes}

    elif fmt == "lrat":
        exe = find_tool("lrat-check")
        if exe is None:
            return die_missing("lrat-check", args)
        backend = "lrat-check"
        rc, log, _ = check(exe, [formula, unpacked], args.timeout)
        if rc is None:
            return die_unknown("lrat-check 超时", args, backend, extra)
        last = last_line_checked(log)
        extra["last_line_checked"] = last
        parsed_ok = (last > 0) if last is not None else None

    elif fmt == "lpr":
        # cake_lpr 是 CakeML 编译出的、经形式化验证的 LPR 检查器，信任等级高于
        # drat-trim（后者是未经验证的 C 程序）。但它有一个必须处理的怪癖：
        # *退出码恒为 0*。空证明、非法提示号、截断证明全都返回 0，判决只在文本里：
        #   通过 -> stdout `s VERIFIED UNSAT`
        #   拒绝 -> stdout 空，stderr 出 `c Checking failed at line: N. Reason: ...`
        # 所以这里不读退出码，只取输出，判决交给下方的 lpr 分支去判。
        exe = find_tool("cake_lpr")
        if exe is None:
            return die_missing("cake_lpr", args)
        backend = "cake_lpr"
        rc, log, _ = check(exe, [formula, unpacked], args.timeout)
        if rc is None:
            return die_unknown("cake_lpr 超时", args, backend, extra)
        if rc != 0:
            # 非 0 只可能是进程级异常（崩溃），不是「证明无效」。
            return die_unknown(f"cake_lpr 异常退出（rc={rc}）", args, backend, extra)
        # cake_lpr 不提供「是否读完整份证明」的自述，故不推断完整性。
        parsed_ok = None

    elif fmt == "alethe":
        # Carcara 检查 SMT 的 Alethe 证明（cvc5 产出）。它的 stdout 只有一个词：
        #   valid   -> 每一步都验证通过
        #   holey   -> 有洞，部分步骤未验证。*也退出 0*，绝不等于通过
        #   invalid -> 证明无效
        exe = find_tool("carcara")
        if exe is None:
            return die_missing("carcara", args)
        backend = "carcara"
        rc, log, _ = check(exe, ["check", unpacked, formula], args.timeout)
        if rc is None:
            return die_unknown("carcara 超时", args, backend, extra)
        # 判决由下方 verdict 块从这三个词里读；退出码不携带 valid/holey 之别。
        parsed_ok = None

    elif fmt == "clrat":
        dec, lrat = find_tool("decompress"), find_tool("lrat-check")
        if dec is None or lrat is None:
            return die_missing("decompress 或 lrat-check", args)
        backend = "decompress|lrat-check"
        rc, dout, _ = check(dec, ["-m", unpacked], args.timeout)
        if rc is None:
            return die_unknown("decompress 超时", args, backend, extra)
        bad = malformed_lrat(dout)
        if bad:
            # 已知上游 bug：绝不把解压器的问题算成证书的问题。
            return die_unknown(
                "decompress 输出不是合法 LRAT"
                f"（{len(bad)} 行异常，首个 {bad[0][:50]!r}）。"
                "上游 decompress.c 的 read_lit 内有一句遗留 printf 把原始字节写入 stdout；"
                "请换用修正后的 decompress，或改用 --format drat。",
                args, backend, extra | {"decompress_broken": True, "malformed_lines": len(bad)})
        plain = os.path.join(workdir, "cert.lrat")
        with open(plain, "w", encoding="utf-8") as fh:
            fh.write(dout)
        rc, log, _ = check(lrat, [formula, plain], args.timeout)
        if rc is None:
            return die_unknown("lrat-check 超时", args, backend, extra)
        last = last_line_checked(log)
        extra["last_line_checked"] = last
        parsed_ok = (last > 0) if last is not None else None

    duration_ms = int((time.monotonic() - started) * 1000)
    if args.verbose:
        for line in log.splitlines():
            if line.strip():
                c(line)

    if fmt == "lpr":
        # cake_lpr 的退出码没有说话能力，判决只能从文本读：
        #   有 `s VERIFIED …`         -> 通过
        #   无判决行但有 `c ` 诊断    -> 被显式拒绝（诊断里带行号与原因）
        #   两者都没有                -> 无法判定，绝不猜
        if re.search(r"^s VERIFIED\b", log, re.M):
            verdict = "VERIFIED"
        elif re.search(r"^c \S", log, re.M):
            verdict = "NOT VERIFIED"
        else:
            verdict = None
    elif fmt == "alethe":
        # carcara 的 stdout 是 valid / holey / invalid 三者之一，退出码不区分它们。
        tok = re.search(r"^(valid|holey|invalid)\b", log, re.M)
        tok = tok.group(1) if tok else None
        if tok == "holey":
            # 有洞 = 部分验证：cvc5 对某些理论引理只吐 `:rule hole`，检查器无法核。
            # 它既不构成通过，也不构成推翻，因此绝不许升格为 exact_certificate。
            return die_unknown(
                "carcara 判定 holey：证明含未验证的步骤（洞）。"
                "这既不通过也不推翻，UNKNOWN 是唯一诚实的结论",
                args, backend, extra | {"carcara_verdict": "holey"})
        if tok is None:
            return die_unknown(f"carcara 未给出可识别判决（rc={rc}）", args, backend, extra)
        verdict = "VERIFIED" if tok == "valid" else "NOT VERIFIED"
        parsed_ok = True
    else:
        m = VERDICT_RE.search(log)
        verdict = m.group(1) if m else None

    record = {
        "schema": "opl.evidence/1",
        "backend": backend,
        "format": fmt,
        "formula": os.path.abspath(formula),
        "formula_sha256": sha256(formula),
        "certificate": os.path.abspath(cert),
        "certificate_sha256": sha256(cert),
        "certificate_bytes": os.path.getsize(cert),
        "parse_complete": parsed_ok,
        "duration_ms": duration_ms,
        "checked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        # 检查器的诊断摘录。拒绝情形必须留证：「哪一行、什么原因」是事后审计
        # 唯一能回答「为什么这份证书不算」的东西，而各检查器的措辞并不统一。
        "checker_messages": checker_messages(log),
        **extra,
    }

    if verdict == "VERIFIED":
        record |= {"verdict": "VERIFIED", "verification_level": "exact_certificate"}
    elif verdict == "NOT VERIFIED" and parsed_ok is False:
        record |= {"verdict": "UNKNOWN", "verification_level": "none",
                   "reason": "校验器未完整读入证书，NOT VERIFIED 不可信（疑似格式误判）"}
    elif verdict == "NOT VERIFIED":
        record |= {"verdict": "NOT VERIFIED", "verification_level": "none"}
    else:
        record |= {"verdict": "UNKNOWN", "verification_level": "none",
                   "reason": "校验器未给出判决行", "checker_exit": rc}

    if args.evidence_out:
        out_json(record, args.evidence_out)

    code = {"VERIFIED": PASS, "NOT VERIFIED": REJECT, "UNKNOWN": UNKNOWN}[record["verdict"]]
    if args.json and not args.quiet:
        out_json(record)
        c(f"s {record['verdict']} {backend} {duration_ms}ms")
    else:
        s(record["verdict"], f"{backend} {duration_ms}ms")
    return code


def die_missing(what: str, args) -> int:
    c(f"缺少后端：{what}。先运行 opl-capabilities，不要回退到估算。")
    if args.json:
        out_json({"schema": "opl.evidence/1", "verdict": "UNKNOWN",
                  "reason": "missing_backend", "missing": what})
    else:
        s("MISSING", what)
    return MISSING


def die_unknown(reason: str, args, backend: str = "", extra: dict | None = None) -> int:
    c(reason)
    if args.json:
        out_json({"schema": "opl.evidence/1", "verdict": "UNKNOWN",
                  "reason": reason, "backend": backend, **(extra or {})})
    else:
        s("UNKNOWN", reason)
    return UNKNOWN


if __name__ == "__main__":
    sys.exit(main())
