#!/usr/bin/env python3
"""opl-certcheck —— 用独立校验器复核一份证书。薄壳：逻辑在 lib/opl_certcheck.py。

一个职责：把「求解器说 UNSAT」变成「第三方可以在不信任求解器的前提下复核」。
自己不判断数学，只调度校验器并把结果翻译成退出码。

用法：
    opl-certcheck --formula F.cnf --cert P.drat [--format auto|drat|lrat|clrat|lpr|alethe]
                  [--timeout S] [--json] [--evidence-out PATH] [--verbose]

退出码：
    0 PASS     校验器报告 VERIFIED
    1 REJECT   校验器报告 NOT VERIFIED，且证据表明证书被完整解析
    3 UNKNOWN  无法判定：格式未识别 / 解析不完整 / 超时 / 解压器坏了
    4 MISSING  所需校验器不存在；或没有签名器——不产出无签名的证据
    2 USAGE    参数错误

本工具最不能犯的错，是把「我读不懂这份证书」报成「这份证书是错的」——那是伪证。
为什么每条路径都必须自己回答「证书被完整读入了吗」，以及各校验器的判决信道为何
互不相同（drat-trim 看退出码、cake_lpr 退出码恒为 0、carcara 不区分 valid 与 holey）
——都写在 lib/opl_certcheck.py 的 docstring 里，改动前请先读它。
"""

from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

from opl_common import PASS, REJECT, UNKNOWN, MISSING, USAGE, c, out_json, s  # noqa: E402
from opl_certcheck import (FAIL_FORMATS, CertError, build_record,  # noqa: E402
                           check_certificate)
from opl_sign import SignError, discard, sign_file  # noqa: E402

EXIT_OF = {"VERIFIED": PASS, "NOT VERIFIED": REJECT, "UNKNOWN": UNKNOWN}


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("formula_pos", nargs="?")
    ap.add_argument("cert_pos", nargs="?")
    ap.add_argument("--formula")
    ap.add_argument("--cert")
    ap.add_argument("--format", default="auto", choices=FAIL_FORMATS)
    ap.add_argument("--timeout", type=float, default=3600.0)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--evidence-out")
    ap.add_argument("--subject", help="这份证据是关于哪个猜想的（id）。"
                                      "台账会核对它——没有它，一份真证据可以被拿去"
                                      "给另一个猜想背书")
    ap.add_argument("--range", dest="vrange", metavar="LO..HI",
                    help="本次检查覆盖的范围。用于支撑 no_counterexample_in_range")
    ap.add_argument("--verbose", action="store_true")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    formula = args.formula or args.formula_pos
    cert = args.cert or args.cert_pos
    if not formula or not cert:
        c("需要 --formula 与 --cert")
        return USAGE
    for p in (formula, cert):
        if not os.path.isfile(p):
            c(f"文件不存在：{p}")
            return USAGE

    try:
        res = check_certificate(formula, cert, args.format, args.timeout)
    except CertError as exc:
        # 「认不出格式」是 UNKNOWN，不是 REJECT——不许把读不懂说成是错的。
        c(str(exc))
        if args.json:
            out_json({"schema": "opl.evidence/1", "verdict": "UNKNOWN",
                      "reason": str(exc)})
        else:
            s("UNKNOWN", str(exc))
        return UNKNOWN

    for note in res.notes:
        c(note)
    c(f"格式判定：{res.fmt}（{res.fmt_why}）")

    if res.failure == "missing_backend":
        c(f"{res.failure_reason}。先运行 opl-capabilities，不要回退到估算。")
        if args.json:
            out_json({"schema": "opl.evidence/1", "verdict": "UNKNOWN",
                      "reason": "missing_backend", "missing": res.missing,
                      "backend": res.backend, **res.extra})
        else:
            s("MISSING", ",".join(res.missing))
        return MISSING

    if args.verbose:
        for line in res.log.splitlines():
            if line.strip():
                c(line)

    if res.failure:
        c(res.failure_reason)
        if args.json:
            out_json({"schema": "opl.evidence/1", "verdict": "UNKNOWN",
                      "reason": res.failure_reason, "failure": res.failure,
                      "backend": res.backend, **res.extra})
        else:
            s("UNKNOWN", res.failure_reason)
        return UNKNOWN

    record = build_record(res=res, formula=formula, cert=cert,
                          subject=args.subject, vrange=args.vrange)
    if args.evidence_out:
        out_json(record, args.evidence_out)
        try:
            sig = sign_file(args.evidence_out)
        except SignError as exc:
            # 不产出无签名的证据：刚写下的那份删掉，然后如实报「没有签名器」。
            # 没签的东西不许冒充成能验的——与「找不到 bwrap 就不降级到裸跑」同一条纪律。
            discard(args.evidence_out)
            c(str(exc))
            s("MISSING", "signer")
            return MISSING
        c(f"已签名：{sig}")

    verdict = record["verdict"]
    if args.json and not args.quiet:
        out_json(record)
        c(f"s {verdict} {res.backend} {res.duration_ms}ms")
    else:
        s(verdict, f"{res.backend} {res.duration_ms}ms")
    return EXIT_OF[verdict]


if __name__ == "__main__":
    sys.exit(main())
