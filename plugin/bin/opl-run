#!/usr/bin/env python3
"""opl-run —— 在受控进程里跑一条命令，落四份运行快照。薄壳：逻辑在 lib/opl_run.py。

一个职责：把「跑一次」变成一份可复核的记录。不评估结果好坏（那是 opl-evolve 的事），
也不判断数学。

用法：
    opl-run [--runs-dir DIR] [--id ID] --workdir DIR [选项] -- CMD [ARG...]

选项：
    --timeout S        墙钟上限（默认 60）
    --mem-mb N         内存上限（MB）。只在 cgroup 可写时生效，否则快照里如实记
                       「未生效」而不是假装设了
    --pids-max N       进程数上限（默认 256）
    --allow-net        不禁网（默认禁）
    --no-sandbox       不套 bwrap。只给自己诊断用，快照里会记下这个事实
    --deep-capabilities  连功能性沙箱探测一起做（默认只记版本，不启额外进程）

退出码（与其他命令共用一套约定）：
    0  PASS            命令跑完且自己退出 0
    1  REJECT          命令跑完但自己退出非 0 —— 「这个任务成功了」被推翻
    2  USAGE           参数错误、工作目录不存在
    3  UNKNOWN         **没有判决**：超时 / 被 OOM 杀 / 被信号杀 / 沙箱起不来。
                       注意 3 不是「失败」——把「没跑出来」记成「跑出来是错的」
                       正是本工具最不能犯的错
    4  MISSING         找不到 bwrap。不降级到裸跑——那会静默丢掉整个隔离保证

`stdout` 输出一行 `s <KIND>`；诊断走 `stderr`；快照落在 `runs/<id>/` 下。
"""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

from opl_common import PASS, REJECT, UNKNOWN, MISSING, USAGE, c, s  # noqa: E402
from opl_run import (BACKEND_MISSING, DONE, NO_VERDICT, OK, PAYLOAD_FAILED,  # noqa: E402
                     RunSpec, dispatch, run_with_status, status_path,
                     wait_status)

_ = DONE  # 文档用得到，壳里不直接引用

KIND_EXIT = {
    OK: PASS,
    PAYLOAD_FAILED: REJECT,
    BACKEND_MISSING: MISSING,
}
# 其余（timeout / oom / oom_inferred / signal / sandbox_error）都是「没有判决」。
# 单列一张表而不是兜底成某个数：兜底会悄悄把一个新结局折进老桶里。
for _k in NO_VERDICT:
    KIND_EXIT.setdefault(_k, UNKNOWN)
KIND_EXIT.setdefault("sandbox_error", UNKNOWN)


def default_runs_dir() -> str:
    lab = os.environ.get("OPL_LAB")
    return os.path.join(lab, "runs") if lab else os.path.join(os.getcwd(), "runs")


def do_detach(spec, args) -> int:
    """派发到后台，确认「已经跑起来」再返回。

    返回 0 表示**派发成功**，不是任务成功——所以 stdout 那行是 `s RUNNING`
    而不是 `s OK`。判决要问 `--wait`。
    """
    info = dispatch(spec)
    st = info.get("status") or {}
    if not info.get("confirmed"):
        c(f"派发未能确认：{info.get('note') or '子进程退出或未写状态'}")
        s("UNDISPATCHED", f"id={spec.run_id} pid={info.get('pid')}")
        return UNKNOWN
    c(f"已派发 id={spec.run_id} pid={info['pid']}")
    s("RUNNING", f"id={spec.run_id}  {spec.runner_dir}")
    return PASS


def do_wait(runner_dir: str, run_id: str, args) -> int:
    """轮询到终态。幂等：已经终态就立刻返回该终态，不重跑。"""
    st = wait_status(runner_dir, timeout=args.wait_timeout)
    if st is None:
        c(f"读不到状态文件：{status_path(runner_dir)}")
        s("UNKNOWN", f"id={run_id} 没有状态可读")
        return UNKNOWN
    if st.get("state") != DONE:
        # 「还不知道」不是「失败」。这里必须给 3，不能给 0 也不能给 1。
        c(f"{args.wait_timeout}s 内仍是 {st.get('state')!r}；这是「还没有结论」，"
          f"不是失败")
        s("RUNNING", f"id={run_id}")
        return UNKNOWN
    kind = str(st.get("kind") or "")
    for note in st.get("notes") or []:
        c(f"注意：{note}")
    elapsed = st.get("elapsed_ms")
    s(kind.upper(), f"id={run_id}  {elapsed}ms  {runner_dir}")
    return KIND_EXIT.get(kind, UNKNOWN)


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--runs-dir", default=None)
    ap.add_argument("--id", default=None)
    ap.add_argument("--workdir", default=None)
    ap.add_argument("--timeout", type=float, default=60.0)
    ap.add_argument("--mem-mb", type=int, default=None)
    ap.add_argument("--pids-max", type=int, default=256)
    ap.add_argument("--allow-net", action="store_true")
    ap.add_argument("--no-sandbox", action="store_true")
    ap.add_argument("--deep-capabilities", action="store_true")
    ap.add_argument("--ro-bind", action="append", default=None, metavar="HOST[:SANDBOX]",
                    help="把一个文件/目录以**只读**方式挂进沙箱（可重复）。"
                         "用来递入可信的东西（评估器、冻结定义）而不暴露整个工作目录；"
                         "不写 SANDBOX 时挂到同路径")
    ap.add_argument("--detach", action="store_true",
                    help="派发到后台，写 runs/<id>/status.json")
    ap.add_argument("--wait", action="store_true",
                    help="轮询到终态（幂等，不重跑）")
    ap.add_argument("--wait-timeout", type=float, default=3600.0)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("cmd", nargs=argparse.REMAINDER,
                    help="-- 之后是要跑的命令")
    args = ap.parse_args()

    cmd = args.cmd
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd and not args.wait:
        c("缺少要跑的命令：写在 -- 之后")
        return USAGE

    workdir = os.path.abspath(args.workdir or os.getcwd())
    if not os.path.isdir(workdir):
        c(f"工作目录不存在：{workdir}")
        return USAGE
    run_id = args.id or f"run-{os.getpid()}"
    runs_dir = os.path.abspath(args.runs_dir or default_runs_dir())
    runner_dir = os.path.join(runs_dir, run_id)
    os.makedirs(runner_dir, exist_ok=True)

    ro_binds = []
    for spec_txt in (args.ro_bind or []):
        host, _, sandbox_path = spec_txt.partition(":")
        host = os.path.abspath(host)
        if not os.path.exists(host):
            c(f"--ro-bind 的源不存在：{host}")
            return USAGE
        ro_binds.append((host, sandbox_path or host))
    spec = RunSpec(argv=cmd, workdir=workdir, run_id=run_id, runner_dir=runner_dir,
                   timeout=args.timeout, mem_max_mb=args.mem_mb,
                   pids_max=args.pids_max, net_off=not args.allow_net,
                   sandboxed=not args.no_sandbox, ro_binds=ro_binds)

    if args.wait:
        # 只读轮询，**绝不重跑**——幂等的全部含义在这里。
        return do_wait(runner_dir, run_id, args)

    if args.detach:
        return do_detach(spec, args)

    res, files = run_with_status(spec, deep_capabilities=args.deep_capabilities)
    for note in res.notes:
        c(f"注意：{note}")
    c(f"运行目录 {runner_dir}")
    if args.json:
        out = {"run_id": run_id, "kind": res.kind, "elapsed_ms": res.elapsed_ms,
               "payload_exit_code": res.payload_exit,
               "payload_signal": res.payload_signal,
               "cgroup": res.cgroup, "snapshots": files}
        print(json.dumps(out, ensure_ascii=False, indent=2, sort_keys=True))
    s(res.kind.upper(), f"{res.elapsed_ms}ms  {runner_dir}")
    return KIND_EXIT.get(res.kind, UNKNOWN)


if __name__ == "__main__":
    sys.exit(main())
